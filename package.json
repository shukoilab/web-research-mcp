{
  "name": "@shukoi/web-research-mcp",
  "version": "2.3.0",
  "description": "Enterprise-grade, ultra-fast, and production-ready Web Research Model Context Protocol (MCP) server featuring undetectable stealth Google Search and token-efficient webpage content extraction.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "web-research",
    "web-scraping",
    "stealth-browser",
    "antibot",
    "patchright",
    "playwright",
    "google-search",
    "readability",
    "markdown",
    "token-efficient",
    "ai-agent",
    "claude-desktop",
    "cursor-mcp",
    "opencode",
    "llm-tools",
    "shukoi"
  ],
  "homepage": "https://github.com/shukoilab/web-research-mcp#readme",
  "bugs": {
    "url": "https://github.com/shukoilab/web-research-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shukoilab/web-research-mcp.git"
  },
  "license": "MIT",
  "author": "Shukoi Lab <https://github.com/shukoilab>",
  "type": "module",
  "main": "./dist/entries/mcp-stdio.js",
  "bin": {
    "web-research-mcp": "./dist/entries/mcp-stdio.js",
    "mcp-web-research": "./dist/entries/mcp-stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "node --watch src/entries/mcp-http.ts",
    "start": "node dist/entries/mcp-http.js",
    "bump": "tsx scripts/bump-version.ts",
    "docker:build": "docker build -t ghcr.io/shukoilab/web-research-mcp:latest .",
    "docker:run": "docker run -d -p 3000:3000 --shm-size=1gb ghcr.io/shukoilab/web-research-mcp:latest",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "@shukoi/core": "^1.0.4",
    "@shukoi/mcp": "^1.0.4",
    "@sinclair/typebox": "^0.34.52",
    "hono": "^4.7.0",
    "jose": "^5.9.6",
    "linkedom": "^0.18.15",
    "patchright": "^1.64.3",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^22.13.4",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
